{
    "version": 6,
    "configurePresets": [
        {
            "name": "linux",
            "displayName": "Linux (native, devcontainer)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_PREFIX_PATH": "$env{QT_LINUX}",
                "DSO_WERROR": "ON"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux debug (devcontainer, F5 in VS Code)",
            "inherits": "linux",
            "binaryDir": "${sourceDir}/build/linux-debug",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "DSO_WERROR": "OFF" }
        },
        {
            "name": "windows",
            "displayName": "Windows x64 (cross-compiled with MinGW-w64, devcontainer)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/windows",
            "toolchainFile": "${sourceDir}/cmake/MingwW64.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_PREFIX_PATH": "$env{QT_WINDOWS}",
                "DSO_WERROR": "ON",
                "DSO_TESTS": "OFF"
            }
        },
        {
            "name": "windows-native",
            "displayName": "Windows (native: Qt online installer with MinGW, libusb release)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/windows-native",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "DSO_TESTS": "OFF"
            }
        }
    ],
    "buildPresets": [
        { "name": "linux", "configurePreset": "linux" },
        { "name": "linux-debug", "configurePreset": "linux-debug" },
        { "name": "windows", "configurePreset": "windows", "targets": ["dso2100scope", "package-windows"] },
        { "name": "windows-native", "configurePreset": "windows-native" }
    ],
    "testPresets": [
        { "name": "linux", "configurePreset": "linux", "output": { "outputOnFailure": true } }
    ]
}
